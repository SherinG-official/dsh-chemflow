# 顶层依赖目录（vendor/node_modules 是**故意入库**的 vendored ssh2，不能忽略）
/node_modules/

# 运行产物：cube / .view 包 / 渲染图，动辄上百 MB
run/

# 打包产物
*.tgz

# 安装脚本留下的备份
*.bak-*
package.json.bak-*
cordis.patch.yml.bak-*

# 凭据（这些永远不要进仓库）
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*

# vendored ssh2 只留运行时需要的部分：它的 test/fixtures 里有一堆示例私钥
/vendor/node_modules/ssh2/test/
/vendor/node_modules/ssh2/examples/
/vendor/node_modules/ssh2/util/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
